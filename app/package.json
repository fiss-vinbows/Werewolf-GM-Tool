{
  "name": "werewolf-gm-tool",
  "private": true,
  "version": "1.0.2",
  "license": "MIT",
  "author": "fiss-vinbows",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "build:electron": "tsc -b && vite build --mode electron",
    "electron": "npm run build:electron && electron .",
    "dist:win": "npm run build:electron && electron-builder --win",
    "build:standalone": "tsc -b && vite build --mode standalone",
    "dist:zip": "npm run build:standalone && node scripts/make-zip.mjs",
    "build:wordpress": "tsc -b && vite build --mode wordpress",
    "dist:wordpress": "npm run build:wordpress && node scripts/make-wordpress-zip.mjs",
    "sim": "vite-node src/sim/run.ts --"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.7"
  },
  "main": "electron/main.cjs",
  "description": "アルティメット人狼GM専用の進行記録ツール",
  "build": {
    "appId": "io.github.fiss-vinbows.werewolf-gm-tool",
    "productName": "人狼GM記録ツール",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "WerewolfGMTool-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "WerewolfGMTool-Portable-${version}.${ext}"
    }
  }
}
